{
  "attachment": {
    "Root": [
      {
        "name": "onClick",
        "type": "() => void",
        "required": false,
        "description": "Click handler for the whole card (not the action buttons). Usually opens a preview."
      },
      {
        "name": "orientation",
        "type": "\"horizontal\" | \"vertical\"",
        "required": false,
        "description": "`\"vertical\"` renders a square card (thumbnail on top, name below). Pairs well with `Attachment.Group`.",
        "default": "horizontal"
      }
    ],
    "Media": [
      {
        "name": "src",
        "type": "string",
        "required": false,
        "description": "Thumbnail image URL. Without it, an icon based on `kind` is shown."
      },
      {
        "name": "alt",
        "type": "string",
        "required": false,
        "description": ""
      },
      {
        "name": "kind",
        "type": "\"file\" | \"code\"",
        "required": false,
        "description": "Built-in icon: `\"file\"` or `\"code\"` (`</>`). Ignored when `src` is set.",
        "default": "file"
      },
      {
        "name": "loading",
        "type": "boolean",
        "required": false,
        "description": "Show a spinner (upload in progress)."
      }
    ],
    "Meta": [
      {
        "name": "size",
        "type": "number",
        "required": false,
        "description": "File size in bytes. Formatted automatically (e.g. 1200000 → \"1.1 MB\")."
      },
      {
        "name": "format",
        "type": "string",
        "required": false,
        "description": "Format label shown before the size, e.g. `\"PNG\"` → \"PNG · 820 KB\"."
      }
    ],
    "Status": [
      {
        "name": "status",
        "type": "AttachmentStatus",
        "required": true,
        "description": ""
      },
      {
        "name": "progress",
        "type": "number",
        "required": false,
        "description": "0–100. Used when `status` is `\"uploading\"`."
      },
      {
        "name": "variant",
        "type": "\"bar\" | \"text\"",
        "required": false,
        "description": "`\"bar\"` renders a progress bar. `\"text\"` renders \"Uploading · 64%\" (pair with `<Attachment.Media loading />`).",
        "default": "bar"
      }
    ],
    "Action": [
      {
        "name": "\"aria-label\"",
        "type": "string",
        "required": true,
        "description": "Defines a string value that labels the current element."
      },
      {
        "name": "children",
        "type": "ReactNode",
        "required": false,
        "description": ""
      }
    ]
  },
  "bubble": {
